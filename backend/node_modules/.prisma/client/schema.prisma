generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  nationalId   String   @unique
  role         String
  passwordHash String?
  status       String   @default("active")
  schoolId     String?
  gradeId      String?
  createdAt    DateTime @default(now())

  school             School?             @relation("SchoolMembers", fields: [schoolId], references: [id])
  grade              Grade?              @relation(fields: [gradeId], references: [id])
  teacherAssignments TeacherAssignment[]
  tasks              Task[]
  submissions        Submission[]
  pushSubscription   PushSubscription?
  messagesAsStudent  Message[]           @relation("StudentMessages")
  messagesAsTeacher  Message[]           @relation("TeacherMessages")

  @@index([role, schoolId])
}

model School {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  address   String?
  phone     String?
  status    String   @default("active")
  createdAt DateTime @default(now())

  admins      User[]              @relation("SchoolMembers")
  grades      SchoolGrade[]
  assignments TeacherAssignment[]
  tasks       Task[]
}

model Grade {
  id                 String              @id @default(cuid())
  name               String              @unique
  order              Int                 @default(0)
  schoolGrades       SchoolGrade[]
  students           User[]
  teacherAssignments TeacherAssignment[]
  tasks              Task[]
}

model SchoolGrade {
  id       String @id @default(cuid())
  schoolId String
  gradeId  String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade    Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([schoolId, gradeId])
}

model TeacherAssignment {
  id        String @id @default(cuid())
  teacherId String
  schoolId  String
  gradeId   String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade     Grade  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([teacherId, schoolId, gradeId])
}

model Task {
  id          String   @id @default(cuid())
  teacherId   String
  schoolId    String
  gradeId     String
  title       String
  description String
  startDate   DateTime
  deadline    DateTime
  status      String   @default("active")
  createdAt   DateTime @default(now())

  teacher     User         @relation(fields: [teacherId], references: [id])
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade       Grade        @relation(fields: [gradeId], references: [id])
  submissions Submission[]
  messages    Message[]
  shareLinks  ShareLink[]

  @@index([schoolId, gradeId, status])
}

model Submission {
  id          String    @id @default(cuid())
  taskId      String
  studentId   String
  imageUrl    String
  score       Int?
  feedback    String?
  gradedAt    DateTime?
  gradedBy    String?
  submittedAt DateTime  @default(now())
  status      String    @default("submitted")
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
}

model Message {
  id             String    @id @default(cuid())
  taskId         String?
  studentId      String
  teacherId      String
  senderId       String
  senderRole     String
  text           String?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  task    Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student User  @relation("StudentMessages", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User  @relation("TeacherMessages", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([taskId, studentId])
  @@index([teacherId, studentId])
}

model ShareLink {
  id        String    @id @default(cuid())
  slug      String    @unique
  taskId    String
  createdBy String
  expiresAt DateTime?
  views     Int       @default(0)
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([slug])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
